# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" (sem .example) é ignorado pelo git e contém segredos reais.

PORT=3000

# Troque por uma string longa e aleatória antes de usar com amigos de verdade.
# É o que assina os tokens de identificação (JWT) — se vazar, alguém pode
# se passar por qualquer nome.
JWT_SECRET=troque_isso_por_uma_string_bem_aleatoria_e_longa

# Em modo --dev, o LiveKit sempre usa essas chaves fixas. Isso é só para
# desenvolvimento local — numa VPS de produção, gere chaves reais
# (livekit-server generate-keys) e configure o LiveKit sem --dev.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL que o CLIENTE vai usar para conectar no LiveKit — não é a URL que o
# backend usa para se comunicar com o LiveKit (aqui não fazemos isso ainda).
# Troque para o seu IP do Tailscale quando for testar com amigos:
# LIVEKIT_URL=ws://100.77.33.34:7880
LIVEKIT_URL=ws://localhost:7880

# Caminho do banco SQLite (histórico do chat). Dentro do Docker, o volume
# em docker-compose.yml mapeia backend/data pra /app/data no container —
# não precisa mudar isso a não ser que rode fora do Docker com outro caminho.
DB_PATH=/app/data/chat.db
