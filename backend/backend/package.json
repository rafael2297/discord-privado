{
  "name": "murmity-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:bundle": "esbuild dist/index.js --bundle --platform=node --target=node22 --external:bufferutil --external:utf-8-validate --outfile=build/bundle.cjs",
    "build:exe": "powershell -ExecutionPolicy Bypass -File build-exe.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
